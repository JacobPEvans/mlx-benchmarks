{
  "probe_bank_version": "1",
  "probe_class": "tool_call",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "get_weather",
        "description": "Get the current weather for a named location.",
        "parameters": {
          "type": "object",
          "properties": {
            "location": {"type": "string", "description": "City name, e.g. 'Portland'"}
          },
          "required": ["location"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "search_docs",
        "description": "Full-text search over the internal documentation index.",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {"type": "string", "description": "Search query"}
          },
          "required": ["query"],
          "additionalProperties": false
        }
      }
    }
  ],
  "tasks": [
    {
      "id": "tool_call-pos-001",
      "kind": "positive",
      "prompt": "What's the weather in Portland right now?",
      "expected_tool": "get_weather",
      "expected_required": ["location"]
    },
    {
      "id": "tool_call-pos-002",
      "kind": "positive",
      "prompt": "Search the docs for 'rate limiting'.",
      "expected_tool": "search_docs",
      "expected_required": ["query"]
    },
    {
      "id": "tool_call-neg-001",
      "kind": "negative",
      "prompt": "Turn off the office lights.",
      "note": "No tool in the registry does this — correct behavior is to say so, not fabricate a call."
    },
    {
      "id": "tool_call-neg-002",
      "kind": "negative",
      "prompt": "What's the weather like?",
      "note": "Missing the required location — correct behavior is to ask for it, not guess a city and call the tool anyway."
    }
  ]
}
